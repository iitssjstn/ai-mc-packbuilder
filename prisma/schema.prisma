// AI Minecraft Server Pack Builder — database schema
// SQLite: zero-config, file-based, no separate DB server or password needed.
//
// SQLite has no native enum or array column types, so what used to be
// Prisma `enum`s and a `SoftwareType[]` list are now plain `String`
// columns instead — validated at the application boundary (Zod schemas,
// and the TS union types in src/lib/enums.ts) rather than by the database.
// See src/lib/enums.ts for the allowed values of each.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------- Users & roles ----------

model User {
  id             String    @id @default(uuid())
  email          String    @unique
  username       String    @unique
  passwordHash   String
  role           String    @default("USER") // Role: USER | ADMIN | OWNER
  isBlocked      Boolean   @default(false)
  packLimit      Int       @default(20)
  termsAcceptedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  conversations AiConversation[]
  packs         ServerPack[]
  auditLogs     AuditLog[]
  notifications Notification[]
}

// ---------- Minecraft versions & server software ----------

model MinecraftVersion {
  id        String   @id @default(uuid())
  version   String   @unique // e.g. "1.21.8"
  edition   String   @default("java")
  releasedAt DateTime?
  isSupported Boolean @default(true)

  softwareCompat ServerSoftwareCompat[]
  packs          ServerPack[]
}

model ServerSoftware {
  id       String @id @default(uuid())
  type     String @unique // SoftwareType
  kind     String          // SoftwareKind: PLUGIN_BASED | MOD_BASED
  name     String
  downloadBaseUrl String?

  versionCompat ServerSoftwareCompat[]
  packs         ServerPack[]
}

// which MinecraftVersion + ServerSoftware combos are valid, and which build
model ServerSoftwareCompat {
  id                 String @id @default(uuid())
  minecraftVersionId String
  serverSoftwareId   String
  buildIdentifier    String? // e.g. Paper build number
  downloadUrl        String?
  checksum           String?

  minecraftVersion MinecraftVersion @relation(fields: [minecraftVersionId], references: [id])
  serverSoftware   ServerSoftware   @relation(fields: [serverSoftwareId], references: [id])

  @@unique([minecraftVersionId, serverSoftwareId])
}

// ---------- Plugin registry ----------

model Plugin {
  id               String    @id @default(uuid())
  slug             String    @unique // e.g. "essentialsx"
  name             String
  description      String
  author           String?
  officialUrl      String?
  documentationUrl String?
  repositoryUrl    String?
  category         String? // e.g. Economy, Permissions, Protection — see src/lib/enums.ts PLUGIN_CATEGORIES
  tags             String? // comma-separated, free-form
  license          String?
  isActive         Boolean   @default(true)
  lastVerifiedAt   DateTime?
  configSchema     String?   // JSON-encoded JSON Schema describing configurable options

  versions      PluginVersion[]
  dependsOn     PluginDependency[] @relation("PluginDependsOn")
  requiredBy    PluginDependency[] @relation("PluginRequiredBy")
  conflictsA    PluginConflict[]   @relation("PluginConflictA")
  conflictsB    PluginConflict[]   @relation("PluginConflictB")
  packPlugins   PackPlugin[]
}

model PluginVersion {
  id              String   @id @default(uuid())
  pluginId        String
  version         String
  minecraftRange  String   // e.g. "1.21.x"
  // Comma-separated SoftwareType values (SQLite has no array column type)
  // — see src/lib/enums.ts, split/join helpers in PluginRegistryService.
  compatibleSoftware String
  downloadUrl     String
  checksum        String?
  createdAt       DateTime @default(now())

  plugin Plugin @relation(fields: [pluginId], references: [id])

  @@unique([pluginId, version])
}

model PluginDependency {
  id            String @id @default(uuid())
  pluginId      String
  dependsOnId   String
  optional      Boolean @default(false)
  reason        String?

  plugin    Plugin @relation("PluginDependsOn", fields: [pluginId], references: [id])
  dependsOn Plugin @relation("PluginRequiredBy", fields: [dependsOnId], references: [id])

  @@unique([pluginId, dependsOnId])
}

model PluginConflict {
  id        String @id @default(uuid())
  pluginAId String
  pluginBId String
  reason    String?

  pluginA Plugin @relation("PluginConflictA", fields: [pluginAId], references: [id])
  pluginB Plugin @relation("PluginConflictB", fields: [pluginBId], references: [id])

  @@unique([pluginAId, pluginBId])
}

// ---------- Mod registry (mirrors plugin registry) ----------

model Mod {
  id           String   @id @default(uuid())
  slug         String   @unique
  name         String
  description  String
  loader       String   // SoftwareType: FABRIC | FORGE | NEOFORGE
  officialUrl  String?
  license      String?
  isActive     Boolean  @default(true)
  configSchema String?  // JSON-encoded

  versions     ModVersion[]
  dependsOn    ModDependency[] @relation("ModDependsOn")
  requiredBy   ModDependency[] @relation("ModRequiredBy")
  conflictsA   ModConflict[]   @relation("ModConflictA")
  conflictsB   ModConflict[]   @relation("ModConflictB")
  packMods     PackMod[]
}

model ModVersion {
  id             String   @id @default(uuid())
  modId          String
  version        String
  minecraftRange String
  downloadUrl    String
  checksum       String?
  createdAt      DateTime @default(now())

  mod Mod @relation(fields: [modId], references: [id])

  @@unique([modId, version])
}

model ModDependency {
  id          String @id @default(uuid())
  modId       String
  dependsOnId String
  optional    Boolean @default(false)
  reason      String?

  mod       Mod @relation("ModDependsOn", fields: [modId], references: [id])
  dependsOn Mod @relation("ModRequiredBy", fields: [dependsOnId], references: [id])

  @@unique([modId, dependsOnId])
}

model ModConflict {
  id      String @id @default(uuid())
  modAId  String
  modBId  String
  reason  String?

  modA Mod @relation("ModConflictA", fields: [modAId], references: [id])
  modB Mod @relation("ModConflictB", fields: [modBId], references: [id])

  @@unique([modAId, modBId])
}

// ---------- AI conversations ----------

model AiConversation {
  id        String   @id @default(uuid())
  userId    String
  title     String?
  planDraft String?  // JSON-encoded — latest structured server plan draft
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User        @relation(fields: [userId], references: [id])
  messages AiMessage[]
}

model AiMessage {
  id             String   @id @default(uuid())
  conversationId String
  role           String   // MessageRole: USER | ASSISTANT | SYSTEM
  content        String
  structuredData String?  // JSON-encoded
  createdAt      DateTime @default(now())

  conversation AiConversation @relation(fields: [conversationId], references: [id])
}

// ---------- Server packs ----------

model ServerPack {
  id                 String   @id @default(uuid())
  userId             String
  name               String
  version            Int      @default(1)
  minecraftVersionId String
  serverSoftwareId   String
  status             String   @default("DRAFT") // PackStatus
  planJson           String   // JSON-encoded — the validated, structured server plan
  filePath           String?  // path in storage adapter, not publicly guessable
  fileSizeBytes      Int?
  errorMessage       String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user             User             @relation(fields: [userId], references: [id])
  minecraftVersion MinecraftVersion @relation(fields: [minecraftVersionId], references: [id])
  serverSoftware   ServerSoftware   @relation(fields: [serverSoftwareId], references: [id])
  plugins          PackPlugin[]
  mods             PackMod[]
  configs          PackConfig[]
  branding         Branding?
  customLinks      CustomLink[]
}

model PackPlugin {
  id           String @id @default(uuid())
  packId       String
  pluginId     String
  version      String

  pack   ServerPack @relation(fields: [packId], references: [id])
  plugin Plugin     @relation(fields: [pluginId], references: [id])

  @@unique([packId, pluginId])
}

model PackMod {
  id      String @id @default(uuid())
  packId  String
  modId   String
  version String

  pack ServerPack @relation(fields: [packId], references: [id])
  mod  Mod        @relation(fields: [modId], references: [id])

  @@unique([packId, modId])
}

model PackConfig {
  id       String @id @default(uuid())
  packId   String
  fileName String // e.g. "server.properties", "essentials/config.yml"
  content  String

  pack ServerPack @relation(fields: [packId], references: [id])

  @@unique([packId, fileName])
}

model Branding {
  id           String  @id @default(uuid())
  packId       String  @unique
  serverName   String?
  motd         String?
  welcomeMsg   String?
  joinMsg      String?
  discordUrl   String?
  twitchUrl    String?
  youtubeUrl   String?
  tiktokUrl    String?
  instagramUrl String?
  websiteUrl   String?
  webshopUrl   String?
  logoPath     String?

  pack ServerPack @relation(fields: [packId], references: [id])
}

model CustomLink {
  id     String @id @default(uuid())
  packId String
  name   String
  url    String

  pack ServerPack @relation(fields: [packId], references: [id])
}

// ---------- Admin / system ----------

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  details   String?  // JSON-encoded
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])
}

model SystemSetting {
  key   String @id
  value String
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String // e.g. "pack_ready" | "pack_failed" | "password_changed"
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}
