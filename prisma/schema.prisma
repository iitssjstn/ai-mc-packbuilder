// AI Minecraft Server Pack Builder — database schema
// PostgreSQL via Prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Users & roles ----------

enum Role {
  USER
  ADMIN
  OWNER
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  username      String   @unique
  passwordHash  String
  role          Role     @default(USER)
  isBlocked     Boolean  @default(false)
  packLimit     Int      @default(20)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  conversations AiConversation[]
  packs         ServerPack[]
  auditLogs     AuditLog[]
}

// ---------- Minecraft versions & server software ----------

model MinecraftVersion {
  id        String   @id @default(uuid())
  version   String   @unique // e.g. "1.21.8"
  edition   String   @default("java")
  releasedAt DateTime?
  isSupported Boolean @default(true)

  softwareCompat ServerSoftwareCompat[]
  packs          ServerPack[]
}

enum SoftwareType {
  VANILLA
  PAPER
  PURPUR
  FABRIC
  FORGE
  NEOFORGE
}

enum SoftwareKind {
  PLUGIN_BASED
  MOD_BASED
}

model ServerSoftware {
  id       String       @id @default(uuid())
  type     SoftwareType @unique
  kind     SoftwareKind
  name     String
  downloadBaseUrl String?

  versionCompat ServerSoftwareCompat[]
  packs         ServerPack[]
}

// which MinecraftVersion + ServerSoftware combos are valid, and which build
model ServerSoftwareCompat {
  id                 String @id @default(uuid())
  minecraftVersionId String
  serverSoftwareId   String
  buildIdentifier    String? // e.g. Paper build number
  downloadUrl        String?
  checksum           String?

  minecraftVersion MinecraftVersion @relation(fields: [minecraftVersionId], references: [id])
  serverSoftware   ServerSoftware   @relation(fields: [serverSoftwareId], references: [id])

  @@unique([minecraftVersionId, serverSoftwareId])
}

// ---------- Plugin registry ----------

model Plugin {
  id            String   @id @default(uuid())
  slug          String   @unique // e.g. "essentialsx"
  name          String
  description   String
  officialUrl   String?
  license       String?
  isActive      Boolean  @default(true)
  configSchema  Json?    // JSON Schema describing configurable options

  versions      PluginVersion[]
  dependsOn     PluginDependency[] @relation("PluginDependsOn")
  requiredBy    PluginDependency[] @relation("PluginRequiredBy")
  conflictsA    PluginConflict[]   @relation("PluginConflictA")
  conflictsB    PluginConflict[]   @relation("PluginConflictB")
  packPlugins   PackPlugin[]
}

model PluginVersion {
  id              String   @id @default(uuid())
  pluginId        String
  version         String
  minecraftRange  String   // e.g. "1.21.x"
  compatibleSoftware SoftwareType[]
  downloadUrl     String
  checksum        String?
  createdAt       DateTime @default(now())

  plugin Plugin @relation(fields: [pluginId], references: [id])

  @@unique([pluginId, version])
}

model PluginDependency {
  id            String @id @default(uuid())
  pluginId      String
  dependsOnId   String
  optional      Boolean @default(false)
  reason        String?

  plugin    Plugin @relation("PluginDependsOn", fields: [pluginId], references: [id])
  dependsOn Plugin @relation("PluginRequiredBy", fields: [dependsOnId], references: [id])

  @@unique([pluginId, dependsOnId])
}

model PluginConflict {
  id        String @id @default(uuid())
  pluginAId String
  pluginBId String
  reason    String?

  pluginA Plugin @relation("PluginConflictA", fields: [pluginAId], references: [id])
  pluginB Plugin @relation("PluginConflictB", fields: [pluginBId], references: [id])

  @@unique([pluginAId, pluginBId])
}

// ---------- Mod registry (mirrors plugin registry) ----------

model Mod {
  id           String   @id @default(uuid())
  slug         String   @unique
  name         String
  description  String
  loader       SoftwareType // FABRIC / FORGE / NEOFORGE
  officialUrl  String?
  license      String?
  isActive     Boolean  @default(true)
  configSchema Json?

  versions     ModVersion[]
  dependsOn    ModDependency[] @relation("ModDependsOn")
  requiredBy   ModDependency[] @relation("ModRequiredBy")
  conflictsA   ModConflict[]   @relation("ModConflictA")
  conflictsB   ModConflict[]   @relation("ModConflictB")
  packMods     PackMod[]
}

model ModVersion {
  id             String   @id @default(uuid())
  modId          String
  version        String
  minecraftRange String
  downloadUrl    String
  checksum       String?
  createdAt      DateTime @default(now())

  mod Mod @relation(fields: [modId], references: [id])

  @@unique([modId, version])
}

model ModDependency {
  id          String @id @default(uuid())
  modId       String
  dependsOnId String
  optional    Boolean @default(false)
  reason      String?

  mod       Mod @relation("ModDependsOn", fields: [modId], references: [id])
  dependsOn Mod @relation("ModRequiredBy", fields: [dependsOnId], references: [id])

  @@unique([modId, dependsOnId])
}

model ModConflict {
  id      String @id @default(uuid())
  modAId  String
  modBId  String
  reason  String?

  modA Mod @relation("ModConflictA", fields: [modAId], references: [id])
  modB Mod @relation("ModConflictB", fields: [modBId], references: [id])

  @@unique([modAId, modBId])
}

// ---------- AI conversations ----------

model AiConversation {
  id        String   @id @default(uuid())
  userId    String
  title     String?
  planDraft Json?    // latest structured server plan draft
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User        @relation(fields: [userId], references: [id])
  messages AiMessage[]
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

model AiMessage {
  id             String      @id @default(uuid())
  conversationId String
  role           MessageRole
  content        String
  structuredData Json?
  createdAt      DateTime    @default(now())

  conversation AiConversation @relation(fields: [conversationId], references: [id])
}

// ---------- Server packs ----------

enum PackStatus {
  DRAFT
  PLANNED
  GENERATING
  READY
  FAILED
}

model ServerPack {
  id                 String     @id @default(uuid())
  userId             String
  name               String
  version            Int        @default(1)
  minecraftVersionId String
  serverSoftwareId   String
  status             PackStatus @default(DRAFT)
  planJson           Json       // the validated, structured server plan
  filePath           String?    // path in storage adapter, not publicly guessable
  fileSizeBytes      Int?
  errorMessage       String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  user             User             @relation(fields: [userId], references: [id])
  minecraftVersion MinecraftVersion @relation(fields: [minecraftVersionId], references: [id])
  serverSoftware   ServerSoftware   @relation(fields: [serverSoftwareId], references: [id])
  plugins          PackPlugin[]
  mods             PackMod[]
  configs          PackConfig[]
  branding         Branding?
  customLinks      CustomLink[]
}

model PackPlugin {
  id           String @id @default(uuid())
  packId       String
  pluginId     String
  version      String

  pack   ServerPack @relation(fields: [packId], references: [id])
  plugin Plugin     @relation(fields: [pluginId], references: [id])

  @@unique([packId, pluginId])
}

model PackMod {
  id      String @id @default(uuid())
  packId  String
  modId   String
  version String

  pack ServerPack @relation(fields: [packId], references: [id])
  mod  Mod        @relation(fields: [modId], references: [id])

  @@unique([packId, modId])
}

model PackConfig {
  id       String @id @default(uuid())
  packId   String
  fileName String // e.g. "server.properties", "essentials/config.yml"
  content  String

  pack ServerPack @relation(fields: [packId], references: [id])

  @@unique([packId, fileName])
}

model Branding {
  id           String  @id @default(uuid())
  packId       String  @unique
  serverName   String?
  motd         String?
  welcomeMsg   String?
  joinMsg      String?
  discordUrl   String?
  twitchUrl    String?
  youtubeUrl   String?
  tiktokUrl    String?
  instagramUrl String?
  websiteUrl   String?
  webshopUrl   String?
  logoPath     String?

  pack ServerPack @relation(fields: [packId], references: [id])
}

model CustomLink {
  id     String @id @default(uuid())
  packId String
  name   String
  url    String

  pack ServerPack @relation(fields: [packId], references: [id])
}

// ---------- Admin / system ----------

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  details   Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])
}

model SystemSetting {
  key   String @id
  value String
}
