# Kopieer naar .env.local naast docker-compose.vps.yml, met echte waarden.

# Postgres (gebruikt door zowel de postgres-container als de app)
POSTGRES_DB=mcpackbuilder
POSTGRES_USER=mcpackbuilder
POSTGRES_PASSWORD=
DB_HOST=postgres
DB_USER=mcpackbuilder
DB_NAME=mcpackbuilder
DB_PASSWORD=

# App
JWT_SECRET=
ENCRYPTION_KEY=
APP_URL=http://localhost:3000

# Bootstrap AI-key (optioneel — na de eerste login stel je keys in via
# Admin -> AI-providers in de website, die winnen dan van deze)
OPENAI_API_KEYS=
AI_PROVIDER_ORDER=openai,anthropic,google
